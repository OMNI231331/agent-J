# ---------- LSW storefront ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_STORE_MODE=preview          # "preview" (pre-launch banner) or "live"
NEXT_PUBLIC_CONTACT_EMAIL=               # overrides the default contact address
NEXT_PUBLIC_INSTAGRAM_URL=               # only set once the official account exists
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LAUNCH_DATE=                 # ISO date, ONLY when confirmed

# ---------- Inventory: Upstash Redis (server-only, never NEXT_PUBLIC) ----------
# Vercel's Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Payments: Stripe (server-only) ----------
STRIPE_SECRET_KEY=                       # sk_test_... for test mode. sk_live_ is refused unless ALLOW_LIVE_PAYMENTS=true AND STORE_MODE=live
STRIPE_WEBHOOK_SECRET=                   # whsec_... from the webhook endpoint you create in Stripe
STRIPE_SHIPPING_RATE_ID=                 # shr_... (optional) created in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false               # true after enabling Stripe Tax
ALLOW_LIVE_PAYMENTS=false                # leave false until docs/CHECKOUT.md "Going live" is complete
CRON_SECRET=                             # any long random string; Vercel Cron sends it as a Bearer token

# ---------- Early-access email list (Resend) ----------
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ---------- eve assistant at /assistant (existing) ----------
BETTER_AUTH_SECRET=
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
