# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables. Never commit real values.

# --- Public ---
NEXT_PUBLIC_CONTACT_EMAIL=
SITE_URL=https://your-domain.example            # used for Stripe redirect URLs; needed in production

# --- Early-access sign-ups (a webhook that accepts JSON {email, source, at}) ---
EARLY_ACCESS_WEBHOOK_URL=

# --- Upstash Redis: stock, reservations, orders. Either naming works; Vercel's Upstash integration sets KV_REST_API_*. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe. Use TEST keys first (sk_test_...). Live keys are refused unless ALLOW_LIVE_PAYMENTS=true. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                           # whsec_... from the webhook endpoint (or `stripe listen` locally)
STRIPE_ALLOWED_COUNTRIES=US
ALLOW_LIVE_PAYMENTS=false

# --- Owner-only endpoints (use long random strings, at least 24 characters) ---
ADMIN_TOKEN=                                     # /api/admin/inventory
CRON_SECRET=                                     # /api/cron/sweep (Vercel sends it automatically)
